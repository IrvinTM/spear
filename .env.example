# Agent home directory (optional, defaults to ~/.ues-agent)
UES_AGENT_HOME=

# Path to the agy binary (optional, auto-detected if not set)
AGY_PATH=

# Max file size in bytes for material uploads (optional, defaults to built-in limit)
MATERIAL_MAX_FILE_BYTES=

# Local TTS (Piper) — optional, falls back to config file values
PIPER_PATH=
PIPER_MODEL_PATH=

# Google Cloud TTS — optional, falls back to config file values
# Use either an API key OR a service account (not both)
GOOGLE_TTS_API_KEY=
# For service accounts: path to the JSON key file (used automatically by google-auth-library)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LANGUAGE=
GOOGLE_TTS_VOICE=
